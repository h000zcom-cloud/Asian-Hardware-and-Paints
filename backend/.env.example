# ============================================================
# Asian Hardware and Paints — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# MongoDB Atlas connection string
# Sign up at https://cloud.mongodb.com and create a free M0 cluster
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://your_user:your_password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name (use different names for dev/staging/prod)
DB_NAME=asian_hardware

# JWT secret for session tokens — generate a strong random string
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string

# CORS: comma-separated exact frontend origins (scheme and port included).
# https://ah.2up.in is always allowed. Add another exact domain only if used.
# For local development:
CORS_ORIGINS=http://localhost:3000

# Server port (Railway/Render will set PORT automatically)
PORT=8001
